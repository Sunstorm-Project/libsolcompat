
/* Part of libsolcompat sysroot — provides ifr_mtu alias for Solaris 7 */
#ifndef _SOLCOMPAT_NET_IF_H_APPEND
#define _SOLCOMPAT_NET_IF_H_APPEND

/* Solaris 7's net/if.h has ifr_metric but not ifr_mtu; many packages
 * (iproute2, libuv, Python, etc.) use ifr_mtu unconditionally. */
#ifndef ifr_mtu
#define ifr_mtu ifr_metric
#endif

#ifndef SOLCOMPAT_INTERFACES_H
#define SOLCOMPAT_INTERFACES_H

#ifndef IF_NAMESIZE
#define IF_NAMESIZE 16
#endif

#ifdef __cplusplus
extern "C" {
#endif

struct if_nameindex {
    unsigned int if_index;
    char *if_name;
};

unsigned int if_nametoindex(const char *);
char *if_indextoname(unsigned int, char *);
struct if_nameindex *if_nameindex(void);
void if_freenameindex(struct if_nameindex *);

#ifdef __cplusplus
}
#endif
#endif

#endif /* _SOLCOMPAT_NET_IF_H_APPEND */
