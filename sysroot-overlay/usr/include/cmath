/*
 * Tell GCC cmath that C99 math functions exist.
 * libsolcompat provides them all.  The corresponding entries in c++config.h
 * are commented-out undef lines, so defining them here is safe.
 */

/* Master gate for C++11 math overloads */
#ifndef _GLIBCXX_USE_C99_MATH_FUNCS
#define _GLIBCXX_USE_C99_MATH_FUNCS 1
#endif

/* C99 generic / TR1 master gates.
 * Without these, libstdc++'s baked <cmath> hides std::isnan/isinf/etc.
 * even though we provide the underlying C functions.  The result is a
 * Catch-22: libstdc++'s own Configure probe `isnan(0);` includes
 * <math.h> → <cmath> → <bits/specfun.h> → tr1/special_function_util.h
 * which references std::isnan, but std::isnan isn't in scope because
 * _GLIBCXX_HAVE_ISNAN isn't set (the very macro the probe is trying
 * to set).  Force-define the gates here so the override fires before
 * libstdc++'s Configure runs again, breaking the cycle. */
#ifndef _GLIBCXX_USE_C99_MATH
#define _GLIBCXX_USE_C99_MATH 1
#endif
#ifndef _GLIBCXX98_USE_C99_MATH
#define _GLIBCXX98_USE_C99_MATH 1
#endif
#ifndef _GLIBCXX11_USE_C99_MATH
#define _GLIBCXX11_USE_C99_MATH 1
#endif
#ifndef _GLIBCXX_USE_C99_MATH_TR1
#define _GLIBCXX_USE_C99_MATH_TR1 1
#endif

